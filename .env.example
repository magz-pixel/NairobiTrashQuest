VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production canonical URL for auth magic-link redirects (e.g. https://ramani-taka.co.ke)
# VITE_SITE_URL=https://your-domain.com

# Production photo checks run only in the analyze-trash Edge Function.
# Set the secret there (never in the browser bundle):
#   npx supabase secrets set GEMINI_API_KEY=your-gemini-key --project-ref momkbsgfypjfujkhrtxb
# Optional model override (defaults to gemini-2.5-flash):
#   npx supabase secrets set GEMINI_MODEL=gemini-2.5-flash --project-ref momkbsgfypjfujkhrtxb
# Local demo only: mock AI without calling the edge function
# VITE_DEMO_MODE=true

# Show built-in Nairobi demo hotspots on the map (set false for production / race day)
# VITE_SHOW_DEMO_DATA=false

# Anonymous reports: true = active on map immediately; false = pending admin review
# VITE_AUTO_APPROVE_REPORTS=true

# CARTO basemap tiles (required in production to avoid "API KEY REQUIRED" watermark)
VITE_CARTO_API_KEY=

# Isolated Mapbox Directions spike only (/spike/mapbox-test) — not used by production Leaflet map
# VITE_MAPBOX_TOKEN=

# Donate Now (public Till / USDT — set on Vercel for production)
# VITE_MPESA_TILL=
# VITE_MPESA_ACCOUNT_NAME=Fix Nairobi
# VITE_MPESA_REFERENCE=DONATE
# VITE_USDT_ADDRESS=
# VITE_USDT_NETWORK=TRC20 (Tron)
