VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production canonical URL for auth magic-link redirects (e.g. https://ramani-taka.co.ke)
# VITE_SITE_URL=https://your-domain.com

# Dev-only: Gemini for report/clear AI (get key at https://aistudio.google.com/apikey)
# VITE_GEMINI_API_KEY=

# Or set GEMINI_API_KEY on the analyze-trash Supabase Edge Function (production)
# Optional: mock AI when no Gemini key (demo only)
# VITE_DEMO_MODE=true

# Show built-in Nairobi demo hotspots on the map (set false for production / race day)
# VITE_SHOW_DEMO_DATA=false

# Anonymous reports: true = active on map immediately; false = pending admin review
# VITE_AUTO_APPROVE_REPORTS=true

# Donate Now (public Till / USDT — set on Vercel for production)
# VITE_MPESA_TILL=
# VITE_MPESA_ACCOUNT_NAME=Fix Nairobi
# VITE_MPESA_REFERENCE=DONATE
# VITE_USDT_ADDRESS=
# VITE_USDT_NETWORK=TRC20 (Tron)
