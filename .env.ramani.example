# Ramani Taka — local Tanzania competition demo
# Copy to .env.ramani (gitignored), then: npm run dev:ramani

VITE_MARKET=ramani-tz
VITE_FORCE_DEMO_DATA=true
VITE_SHOW_DEMO_DATA=true
VITE_DEMO_MODE=true

# Optional: paste your Supabase keys if you want live auth/uploads.
# Demo pins and crowdfunding work without them when FORCE_DEMO_DATA is true.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
